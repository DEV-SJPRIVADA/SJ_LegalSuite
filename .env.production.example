# =============================================================================
# Plantilla de .env para PRODUCCIÓN (Hostinger / sjlegalsuite.sjregistrycat.com)
# =============================================================================
# Este archivo NO se versiona como .env. En el servidor:
#   1. Copiar a la raíz del proyecto:  cp .env.production.example .env
#   2. Generar la clave:               php artisan key:generate
#   3. Rellenar DB_* y secretos.
#   4. Aplicar cambios:                php artisan config:cache
#
# Sin APP_KEY la aplicación responde 500 "No application encryption key has been
# specified" y se cae el login, las sesiones y Livewire (CSRF).
# =============================================================================

APP_NAME="SJ LegalSuite"
APP_ENV=production
APP_DEBUG=false

# Obligatoria. Generar con: php artisan key:generate
# En hPanel → Avanzado → Variables de entorno si no hay acceso SSH.
APP_KEY=

APP_URL=https://sjlegalsuite.sjregistrycat.com
APP_MAIL_URL=https://sjlegalsuite.sjregistrycat.com
# Producción con dominio fijo: los enlaces usan APP_URL, no el Host de la petición.
APP_USE_REQUEST_URL=false

APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de datos (crear en hPanel → Bases de datos MySQL) ---
# Hostinger: DB_HOST=localhost y el usuario lleva prefijo uXXXXXXXX_
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_legalsuite
DB_USERNAME=uXXXXXXXX_legalsuite
DB_PASSWORD=

# --- Directorio corporativo (agenda_users). Dejar vacío si no aplica. ---
AGENDAMIENTO_DB_HOST=
AGENDAMIENTO_DB_PORT=3306
AGENDAMIENTO_DB_DATABASE=
AGENDAMIENTO_DB_USERNAME=
AGENDAMIENTO_DB_PASSWORD=

# --- Sesión ---
# database: sobrevive a reinicios de PHP en hosting compartido (requiere tabla sessions).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Vacío = el dominio actual. No fijar el subdominio aquí o se pierde la cookie.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# --- Colas y caché (tablas de migración) ---
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Broadcast (campanita). log/null = solo polling, sin WebSockets ---
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# --- Correo (configurar buzón real; log solo para pruebas) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@sjregistrycat.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- PDF ---
# dompdf = PHP puro, inmediato, sin Chrome ni cron de cola (recomendado en hosting compartido).
PDF_DRIVER=dompdf
PDF_USE_QUEUE=false
PDF_VIA_ARTISAN_CLI=false
PDF_NO_SANDBOX=true

# --- Despliegue (webhook) ---
# Token largo y aleatorio. Debe coincidir con el usado al llamar /deploy.php.
# Generar: php -r "echo bin2hex(random_bytes(32));"
DEPLOY_WEBHOOK_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Comité disciplinario: en producción dejar false (exige el plazo real de 2 días).
DISCIPLINARY_COMITE_BYPASS_DEADLINE=false
