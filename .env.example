APP_NAME="SJ_LEGALSUITE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Misma convención que SJ_Armory (APP_URL con IP LAN del servidor); puerto 8082 porque Armory usa el 80.
APP_URL=http://172.16.16.90:8082
# true = enlaces/redirecciones/Livewire usan el mismo host:puerto que escribe el usuario en el navegador (cualquier IP del servidor).
# Red de confianza solamente. En producción con dominio fijo suele ser false.
APP_USE_REQUEST_URL=true

APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sj_legalsuite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PDF desde HTML (Browsershot): tras clonar el repo ejecutar npm install (puppeteer en package.json).
# Node/npm suelen autodetectarse (Laragon: C:\laragon\bin\nodejs\..., PATH). Chrome opcional vía PDF_CHROME_PATH.
PDF_CHROME_PATH=
NODE_BINARY=
NPM_BINARY=
PDF_BROWSER_TIMEOUT=120
