APP_NAME="SJ_LEGALSUITE"
APP_ENV=local
# Clave de cifrado (obligatoria para sesión, CSRF y Livewire). Tras copiar este archivo a `.env`, ejecute:
#   php artisan key:generate
# En entornos nuevos puede usar temporalmente la clave de ejemplo siguiente y regenerarla antes de producción.
APP_KEY=base64:b0ehP3XakX2B7cw9NGAxxLsaq8meIpAVwA82GYO9UMw=
APP_DEBUG=true
# IP LAN del servidor Laragon (puerto 8082). Tras cambiar de red ejecute:
#   powershell -ExecutionPolicy Bypass -File scripts/windows/update-lan-url.ps1
# Con APP_USE_REQUEST_URL=true el navegador puede usar otra IP válida del mismo servidor.
APP_URL=http://192.168.18.185:8082
# true = enlaces/redirecciones/Livewire usan el mismo host:puerto que escribe el usuario en el navegador (cualquier IP del servidor).
# Red de confianza solamente. En producción con dominio fijo suele ser false.
APP_USE_REQUEST_URL=true

APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sj_legalsuite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Minutos de inactividad antes de que el servidor invalide la fila de sesión (driver database). Valores muy bajos (p. ej. 2) + pestaña en segundo plano → 419 al poco tiempo.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

# Campanita en tiempo casi real: Pusher Channels (https://dashboard.pusher.com) o `log`/`null` (sólo polling).
BROADCAST_CONNECTION=log
# Si usas Pusher, rellena credenciales del panel y usa pusher:
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# Opcional (Soketi / servidor compatible): PUSHER_HOST= PUSHER_PORT=443 PUSHER_SCHEME=https
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Webhook GitHub → hosting: token largo y aleatorio. URL: POST https://tu-dominio/deploy/{token}
# Dejar vacío en local si no usas despliegue automático.
DEPLOY_WEBHOOK_TOKEN=

# PDF desde HTML (Browsershot): tras clonar el repo ejecutar npm install (puppeteer en package.json).
# Local (Laragon): Node/npm suelen autodetectarse; deje PDF_NO_SANDBOX=false.
# Hosting compartido (Hostinger): rutas absolutas a Node/npm (NVM) + PDF_CHROME_PATH (puppeteer executablePath) + PDF_NO_SANDBOX=true.
PDF_CHROME_PATH=
NODE_BINARY=
NPM_BINARY=
PDF_BROWSER_TIMEOUT=120
PDF_NO_SANDBOX=false

# Comité disciplinario: en desarrollo, true omite el plazo de 2 días antes del botón Comité.
DISCIPLINARY_COMITE_BYPASS_DEADLINE=false
